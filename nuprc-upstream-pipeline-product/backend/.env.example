# PostgreSQL (required for PetroCore backend)
# Use port 5434 when running this project's docker-compose (5432 may be used by other stacks)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/nuprc

# Optional per-layer DB URLs (default: same as DATABASE_URL)
# BRONZE_DB_URL=
# SILVER_DB_URL=
# GOLD_DB_URL=

# PetroCore Tanna Connector v0.1 — service token for /api/v1/tanna/*
# Required for Tanna Core / service integrations. Not used by the frontend.
TANNA_CONNECTOR_TOKEN=change-me-to-a-secure-random-token
